{
  "name": "fighting-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:animation": "playwright test tests/jump-check.spec.ts --reporter=line",
    "test:assets": "python scripts/audit-character-assets.py",
    "asset:generate": "node scripts/generate-image.mjs",
    "asset:slice": "python scripts/slice-spritesheets.py",
    "asset:slice-jumps": "python scripts/slice-jump-strips.py",
    "asset:slice-movement": "python scripts/slice-movement-strips.py",
    "asset:crouch-attacks": "python scripts/create-crouch-attacks.py",
    "asset:hit-reactions": "python scripts/create-hit-reactions.py",
    "asset:normalize": "python scripts/normalize-character-frames.py",
    "asset:ui-portraits": "python scripts/create-ui-portraits.py",
    "asset:ui-vfx": "python scripts/create-ui-vfx-pack.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "openai": "^6.36.0",
    "phaser": "^3.90.0"
  }
}
